{
  "name": "lifeform",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "profile": "tsx scripts/profile.ts",
    "format": "prettier --write src tests scripts *.ts *.json index.html README.md docs/*.md",
    "format:check": "prettier --check src tests scripts *.ts *.json index.html README.md docs/*.md",
    "balance": "tsx scripts/balance.ts",
    "test:production": "tsx scripts/production.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  }
}
